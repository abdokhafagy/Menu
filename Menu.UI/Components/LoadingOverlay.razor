@if (Visible)
{
    <div class="app-loading-overlay" role="status" aria-live="polite" aria-busy="true">
        <MudPaper Class="app-loading-card pa-4" Elevation="0">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudProgressCircular Color="Color.Secondary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.subtitle2">@Message</MudText>
            </MudStack>
        </MudPaper>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Message { get; set; } = "Loading data...";
}
