@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L

<MudSwitch T="bool"
           Color="Color.Secondary"
           Value="AppState.IsDarkMode"
           ValueChanged="OnThemeChanged"
           Label="@L["Theme.Dark"]" />

@code {
    [Inject] private State.AppState AppState { get; set; } = default!;

    private Task OnThemeChanged(bool isDarkMode)
    {
        return AppState.SetDarkModeAsync(isDarkMode);
    }
}
