@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@inject Menu.UI.State.AppState AppState

<MudCard Class="menu-item-card"
         @onclick="HandleCardClick"
         tabindex="@(Item.IsAvailable && !IsLoading ? 0 : -1)"
         style="@(GetCursorStyle())"
         @onkeydown="HandleKeyDown"
         role="button"
         aria-busy="@IsLoading"
         aria-label="@(GetItemName())">

    <div class="menu-item-card__image-wrap">
        <img src="@ImageUrl"
             alt="@(GetItemName())"
             class="menu-item-card__image"
             loading="lazy"
             onerror="this.src='https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=600&q=80'" />

        <div class="menu-item-card__badges">
            @if (!Item.IsAvailable)
            {
                <span class="badge badge--unavailable">@L["MenuItem.Unavailable"]</span>
            }
            else if (Item.IsNew)
            {
                <span class="badge badge--new">@L["MenuItem.New"]</span>
            }
        </div>

        @if (!Item.IsAvailable)
        {
            <div class="menu-item-card__unavailable-overlay">
                <MudText Typo="Typo.body2" Class="menu-item-card__unavailable-text">
                    @L["MenuItem.CurrentlyUnavailable"]
                </MudText>
            </div>
        }
    </div>

    <MudCardContent Class="menu-item-card__content pa-4">
        <div class="menu-item-card__header">
            <MudText Typo="Typo.subtitle1" Class="menu-item-card__name">
                @(GetItemName())
            </MudText>
            <div class="menu-item-card__price-wrap">
                <MudText Typo="Typo.h6" Class="menu-item-card__price">
                    @(GetFormattedPrice())
                </MudText>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(GetItemDescription()))
        {
            <MudText Typo="Typo.body2" Class="menu-item-card__description">
                @(GetItemDescription())
            </MudText>
        }
    </MudCardContent>

    <MudCardActions Class="menu-item-card__actions pa-3 pt-0">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@(!Item.IsAvailable || IsLoading)"
                   EndIcon="@(IsLoading ? null : Icons.Material.Filled.ChevronRight)"
                   Class="menu-item-card__cta"
                   OnClick="HandleViewDetails">
            @if (IsLoading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                <span>Loading...</span>
            }
            else
            {
                @(L["MenuItem.Details"])
            }
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired] public PublicMenuItemSummaryDto Item { get; set; } = default!;

    [Parameter] public bool ReadOnlyMode { get; set; }

    [Parameter] public EventCallback<PublicMenuItemSummaryDto> OnItemClick { get; set; }

    [Parameter] public int AnimationDelayMs { get; set; } = 0;

    [Parameter] public bool IsLoading { get; set; }

    private PublicMenuItemSummaryDto? _renderedItem;
    private bool _renderedReadOnlyMode;
    private bool _renderedIsLoading;
    private string? _renderedCulture;

    protected override bool ShouldRender()
    {
        var culture = AppState.Culture;
        if (ReferenceEquals(_renderedItem, Item)
            && _renderedReadOnlyMode == ReadOnlyMode
            && _renderedIsLoading == IsLoading
            && _renderedCulture == culture)
        {
            return false;
        }

        _renderedItem = Item;
        _renderedReadOnlyMode = ReadOnlyMode;
        _renderedIsLoading = IsLoading;
        _renderedCulture = culture;
        return true;
    }

    private string GetItemName()
        => AppState.Culture == "ar" && !string.IsNullOrWhiteSpace(Item.NameAr)
            ? Item.NameAr
            : Item.Name;

    private string? GetItemDescription()
        => AppState.Culture == "ar" && !string.IsNullOrWhiteSpace(Item.DescriptionAr)
            ? Item.DescriptionAr
            : Item.Description;

    private string GetFormattedPrice() => $"{Item.Price:N2}";

    private string ImageUrl => !string.IsNullOrWhiteSpace(Item.ImageUrl)
        ? Item.ImageUrl
        : "https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=600&q=80";

    private string GetCursorStyle() => Item.IsAvailable && !IsLoading ? "cursor: pointer" : "cursor: default";

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleCardClick();
        }
    }

    private async Task HandleCardClick()
    {
        if (!ReadOnlyMode && Item.IsAvailable && !IsLoading)
        {
            await OnItemClick.InvokeAsync(Item);
        }
    }

    private async Task HandleViewDetails()
    {
        if (!IsLoading)
        {
            await OnItemClick.InvokeAsync(Item);
        }
    }
}
