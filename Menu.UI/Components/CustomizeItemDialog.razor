@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@inject Menu.UI.State.AppState AppState

<MudDialog Class="@GetDialogClass()" Style="@GetDialogStyle()">
    <DialogContent>
        <MudStack Spacing="2" Class="@GetStackClass()">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h5">@GetCurrentItemName()</MudText>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@L["MenuItem.Base"] @Item.Price.ToString("0.00")</MudChip>
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(GetCurrentItemDescription()))
            {
                <MudText Typo="Typo.body2" Class="public-menu-muted">@GetCurrentItemDescription()</MudText>
            }

            @foreach (var option in _sortedOptions)
            {
                var selectedCount = CountSelected(option.Id);
                var values = _sortedValuesByOption[option.Id];
                <MudPaper Class="public-option-panel pa-3" Elevation="0" @key="option.Id">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="option-header">
                        <MudText Typo="Typo.subtitle1" Class="option-name">@GetCurrentOptionName(option)</MudText>
                        <MudText Typo="Typo.caption" Class="public-menu-muted">@GetLocalizedSelectionHint(option, selectedCount)</MudText>
                    </MudStack>

                    @if (IsSingleSelection(option))
                    {
                        <MudRadioGroup T="Guid?"
                                       Value="@GetSingleSelection(option.Id)"
                                       ValueChanged="value => SetSingleSelection(option, value)"
                                       Class="option-group">
                            @foreach (var value in values)
                            {
                                <MudRadio T="Guid?" Value="@value.Id" Color="Color.Primary" Class="rtl-form-control" @key="value.Id">
                                    @GetLocalizedValueLabel(value)
                                </MudRadio>
                            }
                        </MudRadioGroup>
                    }
                    else
                    {
                        <MudStack Spacing="1" Class="option-group">
                            @foreach (var value in values)
                            {
                                <MudCheckBox T="bool"
                                             Value="@IsMultiSelected(option.Id, value.Id)"
                                             ValueChanged="isSelected => ToggleMultiSelection(option, value, isSelected)"
                                             Disabled="@IsMultiSelectionLocked(option, value.Id)"
                                             Class="rtl-form-control"
                                             @key="value.Id">
                                    @GetLocalizedValueLabel(value)
                                </MudCheckBox>
                            }
                        </MudStack>
                    }
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check" OnClick="ConfirmAsync">
            @L["Common.Ok"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public PublicMenuItemDetailDto Item { get; set; } = default!;

    private readonly Dictionary<Guid, HashSet<Guid>> _selectedValuesByOption = new();
    private List<PublicItemOptionDto> _sortedOptions = new();
    private Dictionary<Guid, List<PublicOptionValueDto>> _sortedValuesByOption = new();

    protected override void OnInitialized()
    {
        InitializeDefaults();
        BuildSortedCaches();
    }

    private void BuildSortedCaches()
    {
        _sortedOptions = Item.Options
            .OrderBy(GetCurrentOptionName, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        _sortedValuesByOption = Item.Options.ToDictionary(
            o => o.Id,
            o => o.Values
                .OrderBy(v => v.DisplayOrder)
                .ThenBy(GetCurrentValueName, StringComparer.CurrentCultureIgnoreCase)
                .ToList());
    }

    #region Localization & RTL Helpers

    private bool IsArabic()
        => AppState.Culture == "ar";

    private string GetDialogClass()
        => IsArabic() ? "customize-dialog-rtl" : string.Empty;

    private string GetDialogStyle()
        => IsArabic() ? "direction: rtl;" : string.Empty;

    private string GetStackClass()
        => IsArabic() ? "dialog-content-rtl" : string.Empty;

    #endregion

    #region Current Language Getters

    private string GetCurrentItemName()
        => IsArabic() && !string.IsNullOrWhiteSpace(Item.NameAr)
            ? Item.NameAr
            : Item.Name;

    private string GetCurrentItemDescription()
        => IsArabic() && !string.IsNullOrWhiteSpace(Item.DescriptionAr)
            ? Item.DescriptionAr
            : Item.Description ?? string.Empty;

    private string GetCurrentOptionName(PublicItemOptionDto option)
        => IsArabic() && !string.IsNullOrWhiteSpace(option.NameAr)
            ? option.NameAr
            : option.Name;

    private string GetCurrentValueName(PublicOptionValueDto value)
        => IsArabic() && !string.IsNullOrWhiteSpace(value.ValueAr)
            ? value.ValueAr
            : value.Value;

    #endregion

    #region Display Label Builders

    private string GetLocalizedValueLabel(PublicOptionValueDto value)
        => $"{GetCurrentValueName(value)} ({GetOptionValueTotal(value):0.00})";

    private decimal GetOptionValueTotal(PublicOptionValueDto value)
        => Item.Price + value.PriceModifier;

    private string GetLocalizedSelectionHint(PublicItemOptionDto option, int selectedCount)
    {
        var min = GetEffectiveMin(option);
        var max = GetEffectiveMax(option);
        var maxText = max == int.MaxValue ? L["MenuItem.Any"].Value : max.ToString();

        return L["MenuItem.SelectionHint", selectedCount, min, maxText].Value;
    }

    #endregion

    #region Selection Logic

    private static bool IsSingleSelection(PublicItemOptionDto option)
        => string.Equals(option.SelectionType, "Single", StringComparison.OrdinalIgnoreCase);

    private static int GetEffectiveMax(PublicItemOptionDto option)
    {
        if (IsSingleSelection(option))
        {
            return 1;
        }

        return option.MaxSelections <= 0 ? int.MaxValue : option.MaxSelections;
    }

    private static int GetEffectiveMin(PublicItemOptionDto option)
    {
        var min = Math.Max(0, option.MinSelections);
        if (option.IsRequired)
        {
            min = Math.Max(1, min);
        }

        return min;
    }

    private int CountSelected(Guid optionId)
        => _selectedValuesByOption.TryGetValue(optionId, out var values) ? values.Count : 0;

    private Guid? GetSingleSelection(Guid optionId)
    {
        if (!_selectedValuesByOption.TryGetValue(optionId, out var values) || values.Count == 0)
        {
            return null;
        }

        return values.First();
    }

    private void SetSingleSelection(PublicItemOptionDto option, Guid? valueId)
    {
        var selected = GetOrCreateSelection(option.Id);
        selected.Clear();

        if (valueId.HasValue)
        {
            selected.Add(valueId.Value);
        }
    }

    private bool IsMultiSelected(Guid optionId, Guid valueId)
    {
        return _selectedValuesByOption.TryGetValue(optionId, out var values) && values.Contains(valueId);
    }

    private bool IsMultiSelectionLocked(PublicItemOptionDto option, Guid valueId)
    {
        if (IsSingleSelection(option))
        {
            return false;
        }

        var selected = GetOrCreateSelection(option.Id);
        if (selected.Contains(valueId))
        {
            return false;
        }

        return selected.Count >= GetEffectiveMax(option);
    }

    private void ToggleMultiSelection(PublicItemOptionDto option, PublicOptionValueDto value, bool isSelected)
    {
        var selected = GetOrCreateSelection(option.Id);
        if (isSelected)
        {
            if (selected.Count < GetEffectiveMax(option))
            {
                selected.Add(value.Id);
            }
        }
        else
        {
            selected.Remove(value.Id);
        }
    }

    private HashSet<Guid> GetOrCreateSelection(Guid optionId)
    {
        if (!_selectedValuesByOption.TryGetValue(optionId, out var set))
        {
            set = new HashSet<Guid>();
            _selectedValuesByOption[optionId] = set;
        }

        return set;
    }

    private void InitializeDefaults()
    {
        foreach (var option in Item.Options)
        {
            var selected = option.Values
                .Where(v => v.IsDefault)
                .OrderBy(v => v.DisplayOrder)
                .Select(v => v.Id)
                .ToHashSet();

            var max = GetEffectiveMax(option);
            if (selected.Count > max)
            {
                selected = selected.Take(max).ToHashSet();
            }

            if (IsSingleSelection(option) && selected.Count > 1)
            {
                selected = selected.Take(1).ToHashSet();
            }

            _selectedValuesByOption[option.Id] = selected;
        }
    }

    #endregion

    #region Dialog Actions

    private async Task ConfirmAsync()
    {
        MudDialog.Close(DialogResult.Ok(true));
        await Task.CompletedTask;
    }

    #endregion
}
