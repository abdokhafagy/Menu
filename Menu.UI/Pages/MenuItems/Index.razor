@page "/menu-items"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@using Menu.UI.Auth
@using Menu.UI.Components

<PageTitle>@L["MenuItems.PageTitle"]</PageTitle>

<PageHeader Title="@L["MenuItems.PageTitle"]" SubTitle="@L["MenuItems.SubTitle"]">
    <Actions>
        <PermissionView Permission="@AppPermissions.MenuItemsCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">@L["MenuItems.Add"]</MudButton>
        </PermissionView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" @ref="_table" T="MenuItemDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["MenuItems.Image"]</MudTh>
            <MudTh>@L["MenuItems.Name"]</MudTh>
            <MudTh>@L["MenuItems.Price"]</MudTh>
            <MudTh>@L["MenuItems.Category"]</MudTh>
            <MudTh>@L["MenuItems.Available"]</MudTh>
            <PermissionView Permission="@AppPermissions.MenuItemsUpdate">
                <MudTh>@L["Common.Actions"]</MudTh>
            </PermissionView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (!string.IsNullOrWhiteSpace(context.ImageUrl))
                {
                    <MudImage Src="@context.ImageUrl" Alt="@context.Name" Width="40" Height="40" Style="object-fit:cover;border-radius:50%;" />
                }
                else
                {
                    <MudAvatar Size="Size.Medium">@context.Name[..1].ToUpperInvariant()</MudAvatar>
                }
            </MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Price</MudTd>
            <MudTd>@(context.CategoryName ?? "-")</MudTd>
            <MudTd><MudChip T="string" Color="@(context.IsAvailable ? Color.Success : Color.Error)">@(context.IsAvailable ? L["Common.Yes"] : L["Common.No"])</MudChip></MudTd>
            <PermissionView Permission="@AppPermissions.MenuItemsUpdate">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <PermissionView Permission="@AppPermissions.MenuItemsUpdate">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        </PermissionView>
                        <PermissionView Permission="@AppPermissions.MenuItemsDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                        </PermissionView>
                    </MudStack>
                </MudTd>
            </PermissionView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var item in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@item.Name</MudText>
                    <MudText Typo="Typo.body2">@L["MenuItems.Price"]: @item.Price</MudText>
                    <MudText Typo="Typo.body2">@(item.CategoryName ?? "-")</MudText>
                    <MudChip T="string" Color="@(item.IsAvailable ? Color.Success : Color.Error)">@(item.IsAvailable ? L["Common.Yes"] : L["Common.No"])</MudChip>
                    <PermissionView Permission="@AppPermissions.MenuItemsUpdate">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <PermissionView Permission="@AppPermissions.MenuItemsUpdate">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(item)" />
                            </PermissionView>
                            <PermissionView Permission="@AppPermissions.MenuItemsDelete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(item)" />
                            </PermissionView>
                        </MudStack>
                    </PermissionView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private MenuItemService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<MenuItemDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<MenuItemDto> _rows = Array.Empty<MenuItemDto>();

    private async Task<TableData<MenuItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<MenuItemDto>();
            return new TableData<MenuItemDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<MenuItemDialog>(L["MenuItems.CreateDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["MenuItems.CreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditAsync(MenuItemDto item)
    {
        var parameters = new DialogParameters { [nameof(MenuItemDialog.MenuItem)] = item };
        var dialog = await DialogService.ShowAsync<MenuItemDialog>(L["MenuItems.EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["MenuItems.UpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteAsync(MenuItemDto item)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["MenuItems.DeleteTitle"].ToString(), new DialogParameters
        {
            ["Message"] = string.Format(L["MenuItems.DeleteMessage"], item.Name).ToString(),
            ["ConfirmText"] = L["Common.Delete"].ToString()
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(item.Id);
            await RefreshAsync();
            Snackbar.Add(L["MenuItems.DeletedSuccess"], Severity.Success);
        }
    }
}
