@page "/users"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L

<PageTitle>@L["Users.PageTitle"]</PageTitle>

<PageHeader Title="@L["Users.PageTitle"]" SubTitle="@L["Users.SubTitle"]">
    <Actions>
        <AuthorizeView Roles="superadmin" Context="authState">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateDialogAsync">
                @L["Users.Add"]
            </MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" @ref="_table" T="UserDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["Users.Username"]</MudTh>
            <MudTh>@L["Users.Email"]</MudTh>
            <MudTh>@L["Users.FullName"]</MudTh>
            <MudTh>@L["Users.Restaurant"]</MudTh>
            <MudTh>@L["Users.Status"]</MudTh>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTh>@L["Common.Actions"]</MudTh>
            </AuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Username</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>@context.FullName</MudTd>
            <MudTd>@(context.RestaurantName ?? "-")</MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)">@(context.IsActive ? L["Common.Active"] : L["Common.Inactive"])</MudChip>
            </MudTd>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditDialogAsync(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                    </MudStack>
                </MudTd>
            </AuthorizeView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var user in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@user.FullName</MudText>
                    <MudText Typo="Typo.body2">@user.Username</MudText>
                    <MudText Typo="Typo.body2">@user.Email</MudText>
                    <MudText Typo="Typo.body2">@(user.RestaurantName ?? "-")</MudText>
                    <MudChip T="string" Color="@(user.IsActive ? Color.Success : Color.Error)">@(user.IsActive ? L["Common.Active"] : L["Common.Inactive"])</MudChip>
                    <AuthorizeView Roles="superadmin" Context="authState">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditDialogAsync(user)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(user)" />
                        </MudStack>
                    </AuthorizeView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private UserService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<UserDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<UserDto> _rows = Array.Empty<UserDto>();

    private async Task<TableData<UserDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<UserDto>();
            return new TableData<UserDto>
            {
                Items = _rows,
                TotalItems = result?.TotalCount ?? 0
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<CreateUserDialog>(L["Users.CreateDialogTitle"], options);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await RefreshAsync();
        Snackbar.Add(L["Users.CreatedSuccess"], Severity.Success);
    }

    private async Task OpenEditDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters
        {
            [nameof(CreateUserDialog.User)] = user
        };

        var dialog = await DialogService.ShowAsync<CreateUserDialog>(L["Users.EditDialogTitle"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        });

        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await RefreshAsync();
        Snackbar.Add(L["Users.UpdatedSuccess"], Severity.Success);
    }

    private async Task DeleteAsync(UserDto user)
    {
        var parameters = new DialogParameters
        {
            ["Message"] = string.Format(L["Users.DeleteMessage"], user.Username),
            ["ConfirmText"] = L["Common.Delete"]
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Users.DeleteTitle"], parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        await Service.DeleteAsync(user.Id);
        await RefreshAsync();
        Snackbar.Add(L["Users.DeletedSuccess"], Severity.Success);
    }
}
