@page "/menus"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L

<PageTitle>@L["Menus.PageTitle"]</PageTitle>

<PageHeader Title="@L["Menus.PageTitle"]" SubTitle="@L["Menus.SubTitle"]">
    <Actions>
        <AuthorizeView Roles="superadmin" Context="authState">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">@L["Menus.Add"]</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" @ref="_table" T="MenuDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["Menus.Name"]</MudTh>
            <MudTh>@L["Menus.Restaurant"]</MudTh>
            <MudTh>@L["Menus.Status"]</MudTh>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTh>@L["Common.Actions"]</MudTh>
            </AuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@(context.RestaurantName ?? "-")</MudTd>
            <MudTd><MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)">@(context.IsActive ? L["Common.Active"] : L["Common.Inactive"])</MudChip></MudTd>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                    </MudStack>
                </MudTd>
            </AuthorizeView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var menu in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@menu.Name</MudText>
                    <MudText Typo="Typo.body2">@(menu.RestaurantName ?? "-")</MudText>
                    <MudChip T="string" Color="@(menu.IsActive ? Color.Success : Color.Error)">@(menu.IsActive ? L["Common.Active"] : L["Common.Inactive"])</MudChip>
                    <AuthorizeView Roles="superadmin" Context="authState">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(menu)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(menu)" />
                        </MudStack>
                    </AuthorizeView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private MenuService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<MenuDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<MenuDto> _rows = Array.Empty<MenuDto>();

    private async Task<TableData<MenuDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<MenuDto>();
            return new TableData<MenuDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<MenuDialog>(L["Menus.CreateDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Menus.CreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditAsync(MenuDto menu)
    {
        var parameters = new DialogParameters { [nameof(MenuDialog.Menu)] = menu };
        var dialog = await DialogService.ShowAsync<MenuDialog>(L["Menus.EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Menus.UpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteAsync(MenuDto menu)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(new DialogParameters
        {
            ["Title"] = L["Menus.DeleteTitle"],
            ["Message"] = string.Format(L["Menus.DeleteMessage"], menu.Name),
            ["ConfirmText"] = L["Common.Delete"]
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(menu.Id);
            await RefreshAsync();
            Snackbar.Add(L["Menus.DeletedSuccess"], Severity.Success);
        }
    }
}
