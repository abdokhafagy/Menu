@page "/restaurants"
@page "/resturent"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@inject State.AppState AppState
@using Menu.UI.Models.Public
@using Menu.UI.Auth
@using Menu.UI.Components

<PageTitle>@L["Navigation.Restaurants"]</PageTitle>

<PageHeader Title="@L["Navigation.Restaurants"]" SubTitle="@L["Navigation.SectionManagement"]">
    <Actions>
        <PermissionView Permission="@AppPermissions.RestaurantsCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">
                Add
            </MudButton>
        </PermissionView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" @ref="_table" T="RestaurantDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["Navigation.Restaurants"]</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>@L["Navigation.Menus"]</MudTh>
            <MudTh>@L["Common.Active"]</MudTh>
            <PermissionView Permission="@AppPermissions.RestaurantsUpdate">
                <MudTh>@L["Common.Actions"]</MudTh>
            </PermissionView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @if (!string.IsNullOrWhiteSpace(context.LogoUrl))
                    {
                        <MudImage Src="@context.LogoUrl" Alt="@context.Name" Width="40" Height="40" Style="object-fit:cover;border-radius:50%;" />
                    }
                    else
                    {
                        <MudAvatar Size="Size.Medium">@context.Name[..1].ToUpperInvariant()</MudAvatar>
                    }
                    <MudText Typo="Typo.body1">@context.Name</MudText>
                </MudStack>
            </MudTd>
            <MudTd>@(context.Description ?? "-")</MudTd>
            <MudTd>
                @if (_menusByRestaurant.TryGetValue(context.Id, out var menus) && menus.Count > 0)
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var menu in menus)
                        {
                            <MudLink Href="@GetPublicReadOnlyMenuLink(context.Id)" Target="_blank" Class="mud-chip mud-chip-outlined mud-chip-size-medium mud-chip-default">
                                @menu.Name
                            </MudLink>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2">-</MudText>
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)">@(context.IsActive ? L["Common.Active"] : L["Common.Inactive"])</MudChip>
            </MudTd>
            <PermissionView Permission="@AppPermissions.RestaurantsUpdate">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <PermissionView Permission="@AppPermissions.RestaurantsUpdate">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        </PermissionView>
                        <PermissionView Permission="@AppPermissions.RestaurantsDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                        </PermissionView>
                    </MudStack>
                </MudTd>
            </PermissionView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var restaurant in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (!string.IsNullOrWhiteSpace(restaurant.LogoUrl))
                        {
                            <MudImage Src="@restaurant.LogoUrl" Alt="@restaurant.Name" Width="40" Height="40" Style="object-fit:cover;border-radius:50%;" />
                        }
                        else
                        {
                            <MudAvatar Size="Size.Medium">@restaurant.Name[..1].ToUpperInvariant()</MudAvatar>
                        }
                        <MudText Typo="Typo.subtitle1">@restaurant.Name</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">@(restaurant.Description ?? "-")</MudText>
                    @if (_menusByRestaurant.TryGetValue(restaurant.Id, out var menus) && menus.Count > 0)
                    {
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var menu in menus)
                            {
                                <MudLink Href="@GetPublicReadOnlyMenuLink(restaurant.Id)" Target="_blank" Class="mud-chip mud-chip-outlined mud-chip-size-medium mud-chip-default">
                                    @menu.Name
                                </MudLink>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">-</MudText>
                    }
                    <MudChip T="string" Color="@(restaurant.IsActive ? Color.Success : Color.Error)">@(restaurant.IsActive ? L["Common.Active"] : L["Common.Inactive"])</MudChip>
                    <PermissionView Permission="@AppPermissions.RestaurantsUpdate">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <PermissionView Permission="@AppPermissions.RestaurantsUpdate">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(restaurant)" />
                            </PermissionView>
                            <PermissionView Permission="@AppPermissions.RestaurantsDelete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(restaurant)" />
                            </PermissionView>
                        </MudStack>
                    </PermissionView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private RestaurantService Service { get; set; } = default!;
    [Inject] private PublicMenuService PublicMenuService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<RestaurantDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<RestaurantDto> _rows = Array.Empty<RestaurantDto>();
    private readonly Dictionary<Guid, IReadOnlyList<PublicMenuDto>> _menusByRestaurant = new();

    private async Task<TableData<RestaurantDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<RestaurantDto>();

            _menusByRestaurant.Clear();
            foreach (var restaurant in _rows)
            {
                var menus = await PublicMenuService.GetMenusByRestaurantAsync(restaurant.Id, cancellationToken);
                _menusByRestaurant[restaurant.Id] = menus;
            }

            return new TableData<RestaurantDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<RestaurantDialog>(L["Navigation.Restaurants"], new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Saved successfully.", Severity.Success);
        }
    }

    private async Task OpenEditAsync(RestaurantDto restaurant)
    {
        var parameters = new DialogParameters { [nameof(RestaurantDialog.Restaurant)] = restaurant };
        var dialog = await DialogService.ShowAsync<RestaurantDialog>("Edit Restaurant", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Saved successfully.", Severity.Success);
        }
    }

    private async Task DeleteAsync(RestaurantDto restaurant)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Common.Delete"].ToString(), new DialogParameters
        {
            ["Message"] = restaurant.Name,
            ["ConfirmText"] = L["Common.Delete"].ToString()
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(restaurant.Id);
            await RefreshAsync();
            Snackbar.Add("Saved successfully.", Severity.Success);
        }
    }

    private static string GetPublicReadOnlyMenuLink(Guid restaurantId)
    {
        return $"/public/restaurants/{restaurantId}/menu";
    }
}
