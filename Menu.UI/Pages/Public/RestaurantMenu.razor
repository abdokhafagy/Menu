@page "/public/restaurants/{RestaurantId:guid}/menu"
@attribute [AllowAnonymous]
@layout PublicMenuLayout
@implements IDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L

<div class="public-menu-page fade-in">
    @if (_loading)
    {
        <div class="public-menu-page__hero-skeleton">
            <div class="skeleton-shimmer public-menu-page__hero-cover" />
            <div class="public-menu-page__hero-content">
                <div class="skeleton-shimmer public-menu-page__hero-logo" />
                <div class="public-menu-page__hero-info">
                    <MudSkeleton Height="32px" Width="50%" />
                    <MudSkeleton Height="16px" Width="70%" Class="mt-1" />
                </div>
            </div>
        </div>

        <div class="public-menu-page__tabs-skeleton">
            @for (var i = 0; i < 6; i++)
            {
                <div class="skeleton-shimmer public-menu-page__tab-skeleton" />
            }
        </div>

        <div class="public-menu-page__grid">
            @for (var i = 0; i < 8; i++)
            {
                <MenuSkeleton Index="i" />
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="public-menu-page__error-wrap">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="public-menu-page__error">
                @_error
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="ReloadAsync">
                Try Again
            </MudButton>
        </div>
    }
    else if (_restaurant is not null)
    {
        <RestaurantHeader Restaurant="_restaurant" />

        @if (_menus.Count > 1)
        {
            <div class="public-menu-page__menu-chips">
                <MudChipSet T="string" AllClosable="false">
                    @for (var i = 0; i < _menus.Count; i++)
                    {
                        var menu = _menus[i];
                        var selected = i == _activeMenuIndex;
                        <MudChip T="string"
                                 Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                 Color="@(selected ? Color.Primary : Color.Default)"
                                 OnClick="() => SelectMenuAsync(i)"
                                 Class="public-menu-page__menu-chip">
                            @menu.Name
                        </MudChip>
                    }
                </MudChipSet>
            </div>
        }

        @if (_loadingMenu)
        {
            <div class="public-menu-page__grid mt-4">
                @for (var i = 0; i < 6; i++)
                {
                    <MenuSkeleton Index="i" />
                }
            </div>
        }
        else if (_activeMenu is not null)
        {
            <div class="public-menu-page__sticky-tabs">
                <CategoryTabs Categories="_categories"
                              SelectedCategoryId="_selectedCategoryId ?? Guid.Empty"
                              OnCategorySelected="OnCategorySelected" />
            </div>

            @if (_items.Count == 0)
            {
                <EmptyState Title="No items here"
                            Description="This category has no items yet."
                            Icon="@Icons.Material.Filled.RestaurantMenu"
                            IconColor="Color.Default"
                            Class="public-menu-page__empty" />
            }
            else
            {
                <div class="public-menu-page__grid">
                    @for (var i = 0; i < _items.Count; i++)
                    {
                        var item = _items[i];
                        <MenuItemCard @key="item.Id"
                                      Item="item"
                                      ReadOnlyMode="true"
                                      IsLoading="@(item.Id == _loadingItemId)"
                                      AnimationDelayMs="@(i * 50 % 250)"
                                      OnItemClick="HandleItemClick" />
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public Guid RestaurantId { get; set; }

    [Inject] private PublicMenuService PublicMenuService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private bool _loading = true;
    private bool _loadingMenu;
    private string? _error;

    private PublicRestaurantDto? _restaurant;
    private List<PublicMenuDto> _menus = new();
    private PublicMenuSummaryDto? _activeMenu;
    private Guid? _selectedCategoryId;
    private Guid? _loadingItemId;
    private int _activeMenuIndex;

    private CancellationTokenSource? _menuLoadCts;

    private IReadOnlyList<PublicCategoryMenuSummaryDto> _categories = Array.Empty<PublicCategoryMenuSummaryDto>();
    private IReadOnlyList<PublicMenuItemSummaryDto> _items = Array.Empty<PublicMenuItemSummaryDto>();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    public void Dispose()
    {
        _menuLoadCts?.Cancel();
        _menuLoadCts?.Dispose();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        _categories = Array.Empty<PublicCategoryMenuSummaryDto>();
        _items = Array.Empty<PublicMenuItemSummaryDto>();

        // Yield so the skeleton paints before we kick off network I/O.
        await Task.Yield();

        try
        {
            // Parallelize independent calls; the menu summary still depends on the
            // menu list so it runs in a second round.
            var restaurantTask = PublicMenuService.GetRestaurantByIdAsync(RestaurantId);
            var menusTask = PublicMenuService.GetMenusByRestaurantAsync(RestaurantId);
            await Task.WhenAll(restaurantTask, menusTask);

            _restaurant = restaurantTask.Result;
            if (_restaurant is null)
            {
                _error = "Restaurant not found.";
                return;
            }

            _menus = menusTask.Result.OrderBy(x => x.Name).ToList();
            if (_menus.Count == 0)
            {
                _error = "No active menus available for this restaurant.";
                return;
            }

            _activeMenuIndex = 0;
            await LoadMenuAsync(_menus[_activeMenuIndex].Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectMenuAsync(int index)
    {
        if (index < 0 || index >= _menus.Count)
        {
            return;
        }

        if (_activeMenuIndex == index && _activeMenu?.Id == _menus[index].Id)
        {
            return;
        }

        _activeMenuIndex = index;
        await LoadMenuAsync(_menus[index].Id);
    }

    private async Task LoadMenuAsync(Guid menuId)
    {
        _menuLoadCts?.Cancel();
        _menuLoadCts?.Dispose();
        _menuLoadCts = new CancellationTokenSource();
        var ct = _menuLoadCts.Token;

        _loadingMenu = true;
        _error = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var menu = await PublicMenuService.GetRestaurantMenuAsync(RestaurantId, menuId, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            _activeMenu = menu;
            _categories = menu?.Categories
                .OrderBy(x => x.DisplayOrder)
                .ThenBy(x => x.Name)
                .ToList() ?? (IReadOnlyList<PublicCategoryMenuSummaryDto>)Array.Empty<PublicCategoryMenuSummaryDto>();

            _selectedCategoryId = _categories.Any(c => c.Id == _selectedCategoryId)
                ? _selectedCategoryId
                : _categories.FirstOrDefault()?.Id;

            RebuildItems();
        }
        catch (OperationCanceledException)
        {
            // Superseded by another menu load — ignore.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loadingMenu = false;
            }
        }
    }

    private void RebuildItems()
    {
        if (_selectedCategoryId is null)
        {
            _items = Array.Empty<PublicMenuItemSummaryDto>();
            return;
        }

        var category = _categories.FirstOrDefault(x => x.Id == _selectedCategoryId.Value);
        if (category is null || category.Items.Count == 0)
        {
            _items = Array.Empty<PublicMenuItemSummaryDto>();
            return;
        }

        _items = category.Items
            .OrderBy(x => x.DisplayOrder)
            .ThenBy(x => x.Name)
            .ToList();
    }

    private void OnCategorySelected(Guid categoryId)
    {
        if (_selectedCategoryId == categoryId)
        {
            return;
        }

        _selectedCategoryId = categoryId;
        RebuildItems();
    }

    private async Task HandleItemClick(PublicMenuItemSummaryDto item)
    {
        if (_loadingItemId == item.Id)
        {
            return;
        }

        _loadingItemId = item.Id;

        try
        {
            var detail = await PublicMenuService.GetItemDetailAsync(item.Id);

            if (detail is not null)
            {
                var parameters = new DialogParameters<CustomizeItemDialog>
                {
                    { x => x.Item, detail }
                };

                var dialogRef = await DialogService.ShowAsync<CustomizeItemDialog>(null, parameters, BuildDialogOptions(MaxWidth.Large));
                await dialogRef.Result;
                return;
            }

            await ShowFallbackDetailAsync(item);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await ShowFallbackDetailAsync(item);
        }
        finally
        {
            _loadingItemId = null;
        }
    }

    private Task ShowFallbackDetailAsync(PublicMenuItemSummaryDto item)
    {
        var fallbackParams = new DialogParameters<ItemReadOnlyModal>
        {
            { x => x.Item, item }
        };

        return DialogService.ShowAsync<ItemReadOnlyModal>(null, fallbackParams, BuildDialogOptions(MaxWidth.Medium));
    }

    private static DialogOptions BuildDialogOptions(MaxWidth maxWidth) => new()
    {
        MaxWidth = maxWidth,
        FullWidth = true,
        CloseOnEscapeKey = true,
        BackdropClick = true,
        CloseButton = true
    };
}
