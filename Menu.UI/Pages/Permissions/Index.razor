@page "/permissions"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@using Menu.UI.Auth
@using Menu.UI.Components

<PageTitle>@L["Permissions.PageTitle"]</PageTitle>

<PageHeader Title="@L["Permissions.PageTitle"]" SubTitle="@L["Permissions.SubTitle"]">
    <Actions>
        <PermissionView Permission="@AppPermissions.PermissionsCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">@L["Permissions.Add"]</MudButton>
        </PermissionView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" Breakpoint="Breakpoint.None" @ref="_table" T="PermissionDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["Permissions.Name"]</MudTh>
            <MudTh>@L["Permissions.Module"]</MudTh>
            <MudTh>@L["Permissions.Description"]</MudTh>
            <PermissionView Permission="@AppPermissions.PermissionsUpdate">
                <MudTh>@L["Common.Actions"]</MudTh>
            </PermissionView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Module</MudTd>
            <MudTd>@context.Description</MudTd>
            <PermissionView Permission="@AppPermissions.PermissionsUpdate">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <PermissionView Permission="@AppPermissions.PermissionsUpdate">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        </PermissionView>
                        <PermissionView Permission="@AppPermissions.PermissionsDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                        </PermissionView>
                    </MudStack>
                </MudTd>
            </PermissionView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var permission in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@permission.Name</MudText>
                    <MudText Typo="Typo.body2">@permission.Module</MudText>
                    <MudText Typo="Typo.body2">@permission.Description</MudText>
                    <PermissionView Permission="@AppPermissions.PermissionsUpdate">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <PermissionView Permission="@AppPermissions.PermissionsUpdate">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(permission)" />
                            </PermissionView>
                            <PermissionView Permission="@AppPermissions.PermissionsDelete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(permission)" />
                            </PermissionView>
                        </MudStack>
                    </PermissionView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private PermissionService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<PermissionDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<PermissionDto> _rows = Array.Empty<PermissionDto>();

    private async Task<TableData<PermissionDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<PermissionDto>();
            return new TableData<PermissionDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<PermissionDialog>(L["Permissions.CreateDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Permissions.CreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditAsync(PermissionDto permission)
    {
        var parameters = new DialogParameters { [nameof(PermissionDialog.Permission)] = permission };
        var dialog = await DialogService.ShowAsync<PermissionDialog>(L["Permissions.EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Permissions.UpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteAsync(PermissionDto permission)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Permissions.DeleteTitle"].ToString(), new DialogParameters
        {
            ["Message"] = string.Format(L["Permissions.DeleteMessage"], permission.Name).ToString(),
            ["ConfirmText"] = L["Common.Delete"].ToString()
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(permission.Id);
            await RefreshAsync();
            Snackbar.Add(L["Permissions.DeletedSuccess"], Severity.Success);
        }
    }
}
