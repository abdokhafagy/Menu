@page "/option-values"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L

<PageTitle>@L["OptionValues.PageTitle"]</PageTitle>

<PageHeader Title="@L["OptionValues.PageTitle"]" SubTitle="@L["OptionValues.SubTitle"]">
    <Actions>
        <AuthorizeView Roles="superadmin" Context="authState">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">@L["OptionValues.Add"]</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" @ref="_table" T="OptionValueDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["OptionValues.Value"]</MudTh>
            <MudTh>@L["OptionValues.PriceDelta"]</MudTh>
            <MudTh>@L["OptionValues.Default"]</MudTh>
            <MudTh>@L["OptionValues.Option"]</MudTh>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTh>@L["Common.Actions"]</MudTh>
            </AuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Value</MudTd>
            <MudTd>@context.PriceModifier</MudTd>
            <MudTd>@(context.IsDefault ? L["Common.Yes"] : L["Common.No"])</MudTd>
            <MudTd>@(context.ItemOptionName ?? "-")</MudTd>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                    </MudStack>
                </MudTd>
            </AuthorizeView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var optionValue in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@optionValue.Value</MudText>
                    <MudText Typo="Typo.body2">@L["OptionValues.PriceDelta"]: @optionValue.PriceModifier</MudText>
                    <MudText Typo="Typo.body2">@L["OptionValues.Default"]: @(optionValue.IsDefault ? L["Common.Yes"] : L["Common.No"])</MudText>
                    <MudText Typo="Typo.body2">@(optionValue.ItemOptionName ?? "-")</MudText>
                    <AuthorizeView Roles="superadmin" Context="authState">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(optionValue)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(optionValue)" />
                        </MudStack>
                    </AuthorizeView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private OptionValueService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<OptionValueDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<OptionValueDto> _rows = Array.Empty<OptionValueDto>();

    private async Task<TableData<OptionValueDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<OptionValueDto>();
            return new TableData<OptionValueDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<OptionValueDialog>(L["OptionValues.CreateDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["OptionValues.CreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditAsync(OptionValueDto optionValue)
    {
        var parameters = new DialogParameters { [nameof(OptionValueDialog.OptionValue)] = optionValue };
        var dialog = await DialogService.ShowAsync<OptionValueDialog>(L["OptionValues.EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["OptionValues.UpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteAsync(OptionValueDto optionValue)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["OptionValues.DeleteTitle"].ToString(), new DialogParameters
        {
            ["Message"] = string.Format(L["OptionValues.DeleteMessage"], optionValue.Value).ToString(),
            ["ConfirmText"] = L["Common.Delete"].ToString()
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(optionValue.Id);
            await RefreshAsync();
            Snackbar.Add(L["OptionValues.DeletedSuccess"], Severity.Success);
        }
    }
}
