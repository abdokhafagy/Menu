@page "/option-values"
@attribute [Authorize]

<PageTitle>Option Values</PageTitle>

<PageHeader Title="Option Values" SubTitle="Selectable values in option groups">
    <Actions>
        <AuthorizeView Roles="superadmin" Context="authState">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">Add Value</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable @ref="_table" T="OptionValueDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>Value</MudTh>
            <MudTh>Price Delta</MudTh>
            <MudTh>Default</MudTh>
            <MudTh>Option</MudTh>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTh>Actions</MudTh>
            </AuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Value</MudTd>
            <MudTd>@context.PriceModifier</MudTd>
            <MudTd>@context.IsDefault</MudTd>
            <MudTd>@(context.ItemOptionName ?? "-")</MudTd>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                    </MudStack>
                </MudTd>
            </AuthorizeView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [Inject] private OptionValueService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<OptionValueDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<OptionValueDto> _rows = Array.Empty<OptionValueDto>();

    private async Task<TableData<OptionValueDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<OptionValueDto>();
            return new TableData<OptionValueDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<OptionValueDialog>("Add Value", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Option value created.", Severity.Success);
        }
    }

    private async Task OpenEditAsync(OptionValueDto optionValue)
    {
        var parameters = new DialogParameters { [nameof(OptionValueDialog.OptionValue)] = optionValue };
        var dialog = await DialogService.ShowAsync<OptionValueDialog>("Edit Value", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Option value updated.", Severity.Success);
        }
    }

    private async Task DeleteAsync(OptionValueDto optionValue)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Value", new DialogParameters
        {
            ["Title"] = "Delete Value",
            ["Message"] = $"Delete option value '{optionValue.Value}'? This cannot be undone.",
            ["ConfirmText"] = "Delete"
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(optionValue.Id);
            await RefreshAsync();
            Snackbar.Add("Option value deleted.", Severity.Success);
        }
    }
}
