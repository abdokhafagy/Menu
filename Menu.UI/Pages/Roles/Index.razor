@page "/roles"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@using Menu.UI.Auth
@using Menu.UI.Components

<PageTitle>@L["Roles.PageTitle"]</PageTitle>

<PageHeader Title="@L["Roles.PageTitle"]" SubTitle="@L["Roles.SubTitle"]">
    <Actions>
        <PermissionView Permission="@AppPermissions.RolesCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">@L["Roles.Add"]</MudButton>
        </PermissionView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" Breakpoint="Breakpoint.None" @ref="_table" T="RoleDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["Roles.Name"]</MudTh>
            <MudTh>@L["Roles.Created"]</MudTh>
            <PermissionView Permission="@AppPermissions.RolesUpdate">
                <MudTh>@L["Common.Actions"]</MudTh>
            </PermissionView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
            <PermissionView Permission="@AppPermissions.RolesUpdate">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <PermissionView Permission="@AppPermissions.RolesUpdate">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        </PermissionView>
                        <PermissionView Permission="@AppPermissions.RolesDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                        </PermissionView>
                    </MudStack>
                </MudTd>
            </PermissionView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var role in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@role.Name</MudText>
                    <MudText Typo="Typo.body2">@L["Roles.Created"]: @role.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudText>
                    <PermissionView Permission="@AppPermissions.RolesUpdate">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <PermissionView Permission="@AppPermissions.RolesUpdate">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(role)" />
                            </PermissionView>
                            <PermissionView Permission="@AppPermissions.RolesDelete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(role)" />
                            </PermissionView>
                        </MudStack>
                    </PermissionView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private RoleService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<RoleDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<RoleDto> _rows = Array.Empty<RoleDto>();

    private async Task<TableData<RoleDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<RoleDto>();
            return new TableData<RoleDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<RoleDialog>(L["Roles.CreateDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Roles.CreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditAsync(RoleDto role)
    {
        var parameters = new DialogParameters { [nameof(RoleDialog.Role)] = role };
        var dialog = await DialogService.ShowAsync<RoleDialog>(L["Roles.EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Roles.UpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteAsync(RoleDto role)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Roles.DeleteTitle"].ToString(), new DialogParameters
        {
            ["Message"] = string.Format(L["Roles.DeleteMessage"], role.Name).ToString(),
            ["ConfirmText"] = L["Common.Delete"].ToString()
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(role.Id);
            await RefreshAsync();
            Snackbar.Add(L["Roles.DeletedSuccess"], Severity.Success);
        }
    }
}
