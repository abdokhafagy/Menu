<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="2" Class="crud-form-stack">
            <MudTextField Label="Name" @bind-Value="_name" Required="true" />
            <MudTextField Label="Name AR" @bind-Value="_nameAr" />
            <MudSwitch T="bool" Label="Required" Color="Color.Primary" Class="dialog-toggle" @bind-Value="_isRequired" />
            <MudNumericField T="int" Label="Min Selections" @bind-Value="_minSelections" Required="true" />
            <MudNumericField T="int" Label="Max Selections" @bind-Value="_maxSelections" Required="true" />
            <MudSelect T="SelectionType" Label="Selection Type" @bind-Value="_selectionType">
                <MudSelectItem T="SelectionType" Value="SelectionType.Single">Single</MudSelectItem>
                <MudSelectItem T="SelectionType" Value="SelectionType.Multiple">Multiple</MudSelectItem>
            </MudSelect>
            <MudSelect T="Guid?" Label="Menu Item" @bind-Value="_menuItemId" Required="true" Disabled="_loadingMenuItems">
                @foreach (var menuItem in _menuItems)
                {
                    <MudSelectItem T="Guid?" Value="@menuItem.Id">@menuItem.Name</MudSelectItem>
                }
            </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">@(_busy ? "Saving..." : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ItemOptionDto? ItemOption { get; set; }

    [Inject] private ItemOptionService Service { get; set; } = default!;
    [Inject] private MenuItemService MenuItemService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm? _form;
    private bool _busy;
    private bool _loadingMenuItems = true;
    private string _name = string.Empty;
    private string? _nameAr;
    private bool _isRequired;
    private int _minSelections;
    private int _maxSelections;
    private SelectionType _selectionType = SelectionType.Single;
    private Guid? _menuItemId;
    private List<MenuItemDto> _menuItems = new();

    protected override async Task OnInitializedAsync()
    {
        if (ItemOption is not null)
        {
            _name = ItemOption.Name;
            _nameAr = ItemOption.NameAr;
            _isRequired = ItemOption.IsRequired;
            _minSelections = ItemOption.MinSelections;
            _maxSelections = ItemOption.MaxSelections;
            _selectionType = ItemOption.SelectionType;
            _menuItemId = ItemOption.MenuItemId;
        }

        var result = await MenuItemService.GetAllAsync(new QueryParameters { PageNumber = 1, PageSize = 100 });
        _menuItems = result?.Data.ToList() ?? new List<MenuItemDto>();
        _loadingMenuItems = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid)
            {
                return;
            }
        }

        if (!_menuItemId.HasValue)
        {
            Snackbar.Add("Please select a menu item.", Severity.Error);
            return;
        }

        _busy = true;
        try
        {
            if (ItemOption is null)
            {
                await Service.CreateAsync(new CreateItemOptionRequest(_name, _nameAr, _isRequired, _minSelections, _maxSelections, _selectionType, _menuItemId.Value));
            }
            else
            {
                await Service.UpdateAsync(ItemOption.Id, new UpdateItemOptionRequest(_name, _nameAr, _isRequired, _minSelections, _maxSelections, _selectionType));
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
