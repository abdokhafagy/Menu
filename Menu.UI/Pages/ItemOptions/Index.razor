@page "/item-options"
@attribute [Authorize]

<PageTitle>Item Options</PageTitle>

<PageHeader Title="Item Options" SubTitle="Modifiers and option groups">
    <Actions>
        <AuthorizeView Roles="superadmin" Context="authState">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">Add Option</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable @ref="_table" T="ItemOptionDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Required</MudTh>
            <MudTh>Item</MudTh>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTh>Actions</MudTh>
            </AuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.SelectionType</MudTd>
            <MudTd>@context.IsRequired</MudTd>
            <MudTd>@(context.MenuItemName ?? "-")</MudTd>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                    </MudStack>
                </MudTd>
            </AuthorizeView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [Inject] private ItemOptionService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<ItemOptionDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<ItemOptionDto> _rows = Array.Empty<ItemOptionDto>();

    private async Task<TableData<ItemOptionDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<ItemOptionDto>();
            return new TableData<ItemOptionDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<ItemOptionDialog>("Add Option", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Item option created.", Severity.Success);
        }
    }

    private async Task OpenEditAsync(ItemOptionDto itemOption)
    {
        var parameters = new DialogParameters { [nameof(ItemOptionDialog.ItemOption)] = itemOption };
        var dialog = await DialogService.ShowAsync<ItemOptionDialog>("Edit Option", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Item option updated.", Severity.Success);
        }
    }

    private async Task DeleteAsync(ItemOptionDto itemOption)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Option", new DialogParameters
        {
            ["Title"] = "Delete Option",
            ["Message"] = $"Delete option '{itemOption.Name}'? This cannot be undone.",
            ["ConfirmText"] = "Delete"
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(itemOption.Id);
            await RefreshAsync();
            Snackbar.Add("Item option deleted.", Severity.Success);
        }
    }
}
