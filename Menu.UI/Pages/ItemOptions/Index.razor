@page "/item-options"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@using Menu.UI.Auth
@using Menu.UI.Components

<PageTitle>@L["ItemOptions.PageTitle"]</PageTitle>

<PageHeader Title="@L["ItemOptions.PageTitle"]" SubTitle="@L["ItemOptions.SubTitle"]">
    <Actions>
        <PermissionView Permission="@AppPermissions.ItemOptionsCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">@L["ItemOptions.Add"]</MudButton>
        </PermissionView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" @ref="_table" T="ItemOptionDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["ItemOptions.Name"]</MudTh>
            <MudTh>@L["ItemOptions.Type"]</MudTh>
            <MudTh>@L["ItemOptions.Required"]</MudTh>
            <MudTh>@L["ItemOptions.Item"]</MudTh>
            <PermissionView Permission="@AppPermissions.ItemOptionsUpdate">
                <MudTh>@L["Common.Actions"]</MudTh>
            </PermissionView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.SelectionType</MudTd>
            <MudTd>@(context.IsRequired ? L["Common.Yes"] : L["Common.No"])</MudTd>
            <MudTd>@(context.MenuItemName ?? "-")</MudTd>
            <PermissionView Permission="@AppPermissions.ItemOptionsUpdate">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <PermissionView Permission="@AppPermissions.ItemOptionsUpdate">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        </PermissionView>
                        <PermissionView Permission="@AppPermissions.ItemOptionsDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                        </PermissionView>
                    </MudStack>
                </MudTd>
            </PermissionView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var itemOption in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@itemOption.Name</MudText>
                    <MudText Typo="Typo.body2">@itemOption.SelectionType</MudText>
                    <MudText Typo="Typo.body2">@L["ItemOptions.Required"]: @(itemOption.IsRequired ? L["Common.Yes"] : L["Common.No"])</MudText>
                    <MudText Typo="Typo.body2">@(itemOption.MenuItemName ?? "-")</MudText>
                    <PermissionView Permission="@AppPermissions.ItemOptionsUpdate">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <PermissionView Permission="@AppPermissions.ItemOptionsUpdate">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(itemOption)" />
                            </PermissionView>
                            <PermissionView Permission="@AppPermissions.ItemOptionsDelete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(itemOption)" />
                            </PermissionView>
                        </MudStack>
                    </PermissionView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private ItemOptionService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<ItemOptionDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<ItemOptionDto> _rows = Array.Empty<ItemOptionDto>();

    private async Task<TableData<ItemOptionDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<ItemOptionDto>();
            return new TableData<ItemOptionDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<ItemOptionDialog>(L["ItemOptions.CreateDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["ItemOptions.CreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditAsync(ItemOptionDto itemOption)
    {
        var parameters = new DialogParameters { [nameof(ItemOptionDialog.ItemOption)] = itemOption };
        var dialog = await DialogService.ShowAsync<ItemOptionDialog>(L["ItemOptions.EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["ItemOptions.UpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteAsync(ItemOptionDto itemOption)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["ItemOptions.DeleteTitle"].ToString(), new DialogParameters
        {
            ["Message"] = string.Format(L["ItemOptions.DeleteMessage"], itemOption.Name).ToString(),
            ["ConfirmText"] = L["Common.Delete"].ToString()
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(itemOption.Id);
            await RefreshAsync();
            Snackbar.Add(L["ItemOptions.DeletedSuccess"], Severity.Success);
        }
    }
}
