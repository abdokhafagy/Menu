@page "/categories"
@attribute [Authorize]

<PageTitle>Categories</PageTitle>

<PageHeader Title="Categories" SubTitle="Category groups inside menus">
    <Actions>
        <AuthorizeView Roles="superadmin" Context="authState">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">Add Category</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable @ref="_table" T="CategoryDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Name AR</MudTh>
            <MudTh>Order</MudTh>
            <MudTh>Menu</MudTh>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTh>Actions</MudTh>
            </AuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.NameAr</MudTd>
            <MudTd>@context.DisplayOrder</MudTd>
            <MudTd>@(context.MenuName ?? "-")</MudTd>
            <AuthorizeView Roles="superadmin" Context="authState">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                    </MudStack>
                </MudTd>
            </AuthorizeView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [Inject] private CategoryService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<CategoryDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<CategoryDto> _rows = Array.Empty<CategoryDto>();

    private async Task<TableData<CategoryDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<CategoryDto>();
            return new TableData<CategoryDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<CategoryDialog>("Add Category", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Category created.", Severity.Success);
        }
    }

    private async Task OpenEditAsync(CategoryDto category)
    {
        var parameters = new DialogParameters { [nameof(CategoryDialog.Category)] = category };
        var dialog = await DialogService.ShowAsync<CategoryDialog>("Edit Category", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add("Category updated.", Severity.Success);
        }
    }

    private async Task DeleteAsync(CategoryDto category)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Category", new DialogParameters
        {
            ["Title"] = "Delete Category",
            ["Message"] = $"Delete category '{category.Name}'? This cannot be undone.",
            ["ConfirmText"] = "Delete"
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(category.Id);
            await RefreshAsync();
            Snackbar.Add("Category deleted.", Severity.Success);
        }
    }
}
