@page "/categories"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@using Menu.UI.Auth
@using Menu.UI.Components

<PageTitle>@L["Categories.PageTitle"]</PageTitle>

<PageHeader Title="@L["Categories.PageTitle"]" SubTitle="@L["Categories.SubTitle"]">
    <Actions>
        <PermissionView Permission="@AppPermissions.CategoriesCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">@L["Categories.Add"]</MudButton>
        </PermissionView>
    </Actions>
</PageHeader>

<MudPaper Class="panel pa-4">
    <MudTable Class="entity-table" Breakpoint="Breakpoint.None" @ref="_table" T="CategoryDto" ServerData="LoadServerData" Dense="true" Hover="true" Loading="_loading" RowsPerPage="10">
        <HeaderContent>
            <MudTh>@L["Categories.Name"]</MudTh>
            <MudTh>@L["Categories.NameAr"]</MudTh>
            <MudTh>@L["Categories.Order"]</MudTh>
            <MudTh>@L["Categories.Menu"]</MudTh>
            <PermissionView Permission="@AppPermissions.CategoriesUpdate">
                <MudTh>@L["Common.Actions"]</MudTh>
            </PermissionView>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.NameAr</MudTd>
            <MudTd>@context.DisplayOrder</MudTd>
            <MudTd>@(context.MenuName ?? "-")</MudTd>
            <PermissionView Permission="@AppPermissions.CategoriesUpdate">
                <MudTd>
                    <MudStack Row="true" Spacing="1" Class="entity-actions">
                        <PermissionView Permission="@AppPermissions.CategoriesUpdate">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(context)" />
                        </PermissionView>
                        <PermissionView Permission="@AppPermissions.CategoriesDelete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(context)" />
                        </PermissionView>
                    </MudStack>
                </MudTd>
            </PermissionView>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
        </PagerContent>
    </MudTable>

    <MudStack Class="entity-mobile-list" Spacing="2">
        @foreach (var category in _rows)
        {
            <MudPaper Class="entity-mobile-card pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">@category.Name</MudText>
                    <MudText Typo="Typo.body2">@category.NameAr</MudText>
                    <MudText Typo="Typo.body2">@L["Categories.Order"]: @category.DisplayOrder</MudText>
                    <MudText Typo="Typo.body2">@(category.MenuName ?? "-")</MudText>
                    <PermissionView Permission="@AppPermissions.CategoriesUpdate">
                        <MudStack Row="true" Spacing="1" Class="entity-actions">
                            <PermissionView Permission="@AppPermissions.CategoriesUpdate">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditAsync(category)" />
                            </PermissionView>
                            <PermissionView Permission="@AppPermissions.CategoriesDelete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(category)" />
                            </PermissionView>
                        </MudStack>
                    </PermissionView>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudPaper>

@code {
    [Inject] private CategoryService Service { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudTable<CategoryDto>? _table;
    private bool _loading = true;
    private IReadOnlyList<CategoryDto> _rows = Array.Empty<CategoryDto>();

    private async Task<TableData<CategoryDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await Service.GetAllAsync(new QueryParameters { PageNumber = state.Page + 1, PageSize = state.PageSize }, cancellationToken);
            _rows = result?.Data ?? Array.Empty<CategoryDto>();
            return new TableData<CategoryDto> { Items = _rows, TotalItems = result?.TotalCount ?? 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<CategoryDialog>(L["Categories.CreateDialogTitle"], new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Categories.CreatedSuccess"], Severity.Success);
        }
    }

    private async Task OpenEditAsync(CategoryDto category)
    {
        var parameters = new DialogParameters { [nameof(CategoryDialog.Category)] = category };
        var dialog = await DialogService.ShowAsync<CategoryDialog>(L["Categories.EditDialogTitle"], parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await RefreshAsync();
            Snackbar.Add(L["Categories.UpdatedSuccess"], Severity.Success);
        }
    }

    private async Task DeleteAsync(CategoryDto category)
    {
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Categories.DeleteTitle"].ToString(), new DialogParameters
        {
            ["Message"] = string.Format(L["Categories.DeleteMessage"], category.Name).ToString(),
            ["ConfirmText"] = L["Common.Delete"].ToString()
        });

        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            await Service.DeleteAsync(category.Id);
            await RefreshAsync();
            Snackbar.Add(L["Categories.DeletedSuccess"], Severity.Success);
        }
    }
}
