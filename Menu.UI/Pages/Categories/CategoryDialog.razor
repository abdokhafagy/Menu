<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="2" Class="crud-form-stack">
            <MudTextField Label="Name" @bind-Value="_name" Required="true" />
            <MudTextField Label="Name AR" @bind-Value="_nameAr" />
            <MudNumericField T="int" Label="Display Order" @bind-Value="_displayOrder" Required="true" />
            <MudSelect T="Guid?" Label="Menu" @bind-Value="_menuId" Required="true" Disabled="_loadingMenus">
                @foreach (var menu in _menus)
                {
                    <MudSelectItem T="Guid?" Value="@menu.Id">@menu.Name</MudSelectItem>
                }
            </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_busy">@(_busy ? "Saving..." : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CategoryDto? Category { get; set; }

    [Inject] private CategoryService Service { get; set; } = default!;
    [Inject] private MenuService MenuService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm? _form;
    private bool _busy;
    private bool _loadingMenus = true;
    private string _name = string.Empty;
    private string? _nameAr;
    private int _displayOrder;
    private Guid? _menuId;
    private List<MenuDto> _menus = new();

    protected override async Task OnInitializedAsync()
    {
        if (Category is not null)
        {
            _name = Category.Name;
            _nameAr = Category.NameAr;
            _displayOrder = Category.DisplayOrder;
            _menuId = Category.MenuId;
        }

        var result = await MenuService.GetAllAsync(new QueryParameters { PageNumber = 1, PageSize = 100 });
        _menus = result?.Data.ToList() ?? new List<MenuDto>();
        _loadingMenus = false;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid)
            {
                return;
            }
        }

        if (!_menuId.HasValue)
        {
            Snackbar.Add("Please select a menu.", Severity.Error);
            return;
        }

        _busy = true;
        try
        {
            if (Category is null)
            {
                await Service.CreateAsync(new CreateCategoryRequest(_name, _nameAr, _displayOrder, _menuId.Value));
            }
            else
            {
                await Service.UpdateAsync(Category.Id, new UpdateCategoryRequest(_name, _nameAr, _displayOrder));
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
