@inject Microsoft.Extensions.Localization.IStringLocalizer<Menu.UI.SharedResources> L
@inject Menu.UI.State.UserContextService UserContext
@implements IDisposable

<MudNavMenu Class="app-nav-menu">
    <MudText Typo="Typo.h6" Class="app-nav-menu__title">@L["Navigation.Workspace"]</MudText>

    @{
        var visible = NavigationFilter.Visible(UserContext);
        var grouped = visible
            .GroupBy(i => i.Section)
            .OrderBy(g => (int)g.Key)
            .ToList();
        var first = true;
    }

    @foreach (var group in grouped)
    {
        if (!first)
        {
            <MudDivider Class="my-2" />
        }
        first = false;

        <MudText Typo="Typo.caption" Class="app-nav-menu__section">
            @L[SectionKey(group.Key)]
        </MudText>

        @foreach (var item in group)
        {
            <MudNavLink Href="@item.Route"
                        Match="@item.Match"
                        Icon="@item.Icon">
                @L[item.TitleKey]
            </MudNavLink>
        }
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        UserContext.OnContextChanged += HandleContextChanged;
    }

    private void HandleContextChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private static string SectionKey(NavSection section) => section switch
    {
        NavSection.Overview => "Navigation.SectionOverview",
        NavSection.Management => "Navigation.SectionManagement",
        NavSection.Access => "Navigation.SectionAccess",
        _ => "Navigation.SectionOverview"
    };

    public void Dispose()
    {
        UserContext.OnContextChanged -= HandleContextChanged;
    }
}
